SERVICE_NAME=transaction
NODE_ENV=local
HTTP_PORT=9002
HTTP_HOST=localhost
HTTP_PREFIX=/api/transaction
HTTP_VERSION=1
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5133
DB_DATABASE=transaction-db
